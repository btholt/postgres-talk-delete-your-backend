#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."

usage() {
  echo "Usage: ./scripts/demo {prepare|start|stop|status|logs|reset} [--confirm-delete-demo-data]" >&2
}
command="${1:-}"
case "$command" in
  prepare)
    docker compose pull --ignore-buildable
    docker compose build
    ;;
  start)
    docker compose up -d --no-build --pull never --wait --wait-timeout 240
    echo "Kickstopper: http://localhost:3000 | Postgres: localhost:54320"
    ;;
  stop) docker compose stop ;;
  status) docker compose ps ;;
  logs) docker compose logs --tail 80 ;;
  reset)
    if [[ "${2:-}" != "--confirm-delete-demo-data" ]]; then
      echo "Reset deletes only kickstopper-00-original demo volumes. To confirm:" >&2
      echo "./scripts/demo reset --confirm-delete-demo-data" >&2
      exit 2
    fi
    docker compose down --volumes
    docker compose up -d --no-build --pull never --wait --wait-timeout 240
    ;;
  *) usage; exit 2 ;;
esac
